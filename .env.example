# Nazwa i środowisko aplikacji
APP_NAME="eBobo"
ENVIRONMENT=local
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# CORS - lista originów oddzielona przecinkami, "*" dla wszystkich (tylko dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Baza danych (SQLite domyślnie; podmień na PostgreSQL w produkcji,
# np. postgresql+psycopg://user:password@host:5432/dbname)
DATABASE_URL=sqlite:///./app.db

# Upload plików
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads

# Symulowane integracje zewnętrzne
ZUS_MOCK_BASE_URL=https://mock.zus.local
MOBYWATEL_MOCK_BASE_URL=https://mock.mobywatel.local

# Panel administracyjny (/admin) - MVP: jeden użytkownik.
# WAŻNE: zmień ADMIN_PASSWORD i SECRET_KEY przed jakimkolwiek wdrożeniem poza localhost.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SECRET_KEY=dev-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Sesja użytkownika końcowego (anonimowa + po symulowanym logowaniu mObywatel)
USER_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# eBobo Legal Intelligence - dostawca AI (OpenRouter) dla wyjaśniania wyników oceny
# uprawnień. Bez klucza endpoint /legal-advisor/explain/* nadal działa - zwraca
# deterministyczny fallback (ai_available=false) zamiast wywołania AI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=15
